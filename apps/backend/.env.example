PORT=3001
NODE_ENV=production
MONGODB_URI=MONGODB_URI
WORKING_DIR=WORKING_DIR

# Generate a long random secret, e.g. `openssl rand -hex 64`
JWT_SECRET=your-super-secret-key
JWT_EXPIRES_IN=12h

# MCP remote access (min 32 chars). Leave empty to keep /mcp disabled.
# Generate with: openssl rand -hex 64
MCP_SECRET=

# Comma-separated list of allowed origins for CORS. Falls back to APP_URL when empty.
# Example: ALLOWED_ORIGINS=https://dashboard.example.com,https://admin.example.com
ALLOWED_ORIGINS=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="PM2 Dashboard" <noreply@example.com>
APP_NAME=PM2 Dashboard
APP_URL=http://localhost:3000

# Domain Management
SERVER_IP=your.server.ip.here
CERTBOT_EMAIL=admin@yourdomain.com
